{
  "name": "swespy-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/prepare.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare.mjs",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "maplibre-gl": "^6.17.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
