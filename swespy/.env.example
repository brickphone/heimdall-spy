# Copy to .env for local Python execution. Never commit tokens.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=swespy_embeddings
CLIP_MODEL_NAME=openai/clip-vit-large-patch14
EMBEDDING_DIM=768
S2_CELL_LEVEL=14
TOP_K_RESULTS=5
TESTING=false
# Ingestion is not part of startup. Supply a Linkoping bbox before ever running it.
# MAPILLARY_ACCESS_TOKEN=
# SWEDEN_BBOX=[min_lon,min_lat,max_lon,max_lat]
